# Copy to `.env` and edit:  cp .env.example .env
# docker-compose automatically interpolates every variable below.

# ── Published port ──────────────────────────────────────────────────────────
# The host address the port is published on. compose passes this value into the
# container as TTS_PUBLISH_ADDR, which is what app/security.py checks at
# startup - so changing this to 0.0.0.0 to reach the service from another
# machine also trips the exposure guard, which refuses to start unless
# TTS_API_KEYS is set or TTS_ALLOW_REMOTE=true. Do not set TTS_PUBLISH_ADDR
# yourself; it is derived from this one on purpose. See README section 6.
TTS_BIND_HOST=127.0.0.1
TTS_PORT=8000

# ── Model ───────────────────────────────────────────────────────────────────
# dots-studio/dots.tts-mf   -> MeanFlow student: 4.55 GiB of bf16 weights and a
#                              2-step sampler, which is the only checkpoint that
#                              fits the 5.5 GB budget on a 6 GB RTX 4050.
# dots-studio/dots.tts-soar -> highest speaker similarity, but its smallest
#                              official memory bucket is already 5.65 GB, i.e.
#                              above the 5.5 GB budget on this GPU.
TTS_MODEL_NAME=dots-studio/dots.tts-mf
TTS_PRECISION=bfloat16
# --optimize swaps the full-recompute DiT for a KV-cached one. Required for the
# RTF target, but it is what makes the memory patches below necessary.
TTS_OPTIMIZE=true
TTS_WARMUP_ON_OPTIMIZE=true

# Maximum TOTAL audio patches (reference prompt + generated). 1 patch = 160 ms.
# 128 -> 20.5 s of audio per request. VERIFIED on an RTX 4050 Laptop: 5.36 GB peak
# and RTF 0.44 at 2 sampling steps.
# NOTE: DiT's KV cache is sized by num_steps, so this budget is coupled to the
# step count. Measured on this card: even at 4 steps 128 patches fits (5518 MB
# peak) for +17 % time and +0.021 speaker similarity -- drop to 96 only if a
# longer reference pushes the peak over TTS_VRAM_LIMIT_GB.
TTS_MAX_GENERATE_LENGTH=128
# LLM KV-cache length in tokens. The checkpoint default is 2048; halving it to
# 1024 saves ~170 MB of VRAM, which is part of what makes the 128-patch budget
# reachable here.
TTS_MAX_SEQUENCE_LENGTH=1024
TTS_VOCODER_MERGE_STEPS=4

# Low-VRAM patches (see app/patches.py). These are NOT optional on a 6 GB card:
#   * the DiT AdaLN fusion otherwise duplicates a 292 MiB modulation matrix;
#   * torch.compile's "reduce-overhead" mode reserves a cudagraph pool and aborts
#     the allocator checkpoint on this GPU;
#   * the BigVGAN vocoder is decoded in bounded chunks so its activation peak
#     does not grow with utterance length.
TTS_LOW_VRAM_PATCHES=true
# Latent patches per BigVGAN call (12 ~= 1.9 s of audio).
TTS_VOCODER_CHUNK_PATCHES=12

# ── Sampling defaults (spec Phase 3, Task 3.3) ─────────────────────────────
# 2 steps is the MeanFlow default. It also halves the DiT KV cache, which is
# what keeps 128 patches inside the VRAM budget.
TTS_NUM_STEPS=2
TTS_GUIDANCE_SCALE=1.2
TTS_SPEAKER_SCALE=1.5
TTS_SEED=42
TTS_LANGUAGE=none
TTS_NORMALIZE_TEXT=false

# ── Acceptance thresholds ──────────────────────────────────────────────────
TTS_VRAM_LIMIT_GB=5.5
TTS_RTF_TARGET=0.5

# ── Reference audio / chunking ─────────────────────────────────────────────
TTS_NOISE_PROP_DECREASE=0.85
TTS_STATIONARY_NOISE=true
TTS_SAMPLE_RATE=48000
TTS_REF_MIN_SECONDS=5
TTS_REF_MAX_SECONDS=15
# Words per synthesis chunk. `process_txt.py --max-words auto` overrides this
# with a value derived from the live server (recommended on a 6 GB GPU).
TTS_CHUNK_MAX_WORDS=35
TTS_WORDS_PER_SECOND=2.5
TTS_MAX_RETRIES=3

# ── Service ────────────────────────────────────────────────────────────────
TTS_LOG_LEVEL=info
# Base URL used by the client scripts (localhost works both on the host with
# the port published and inside the container).
TTS_API_URL=http://localhost:8000
# Service identity. Left unset on purpose: the defaults come from
# app/__init__.py, so VoxDock's name is defined in exactly one place.
# Override only when running a private fork:
# TTS_API_TITLE=VoxDock
# TTS_API_VERSION=1.0.0

# ── Deployment identity (docker-compose.yml) ────────────────────────────────
# Also defaulted from app/__init__.py; run `python scripts/check_identity.py`
# to confirm the two agree.
# VOXDOCK_IMAGE=voxdock-tts
# VOXDOCK_CONTAINER=voxdock-tts
# VOXDOCK_COMPOSE_PROJECT=voxdock
# VOXDOCK_HF_CACHE_VOLUME=local_tts_hf_cache

# Optional: Hugging Face token (only needed for gated/private checkpoints).
HF_TOKEN=

# ---- Running as you, not root ----------------------------------------------
# The container runs as this uid:gid so files it writes into ./data belong to
# you rather than to root. Check yours with `id -u` / `id -g`; 1000 is the
# common first user. Changing these needs a rebuild, because the uid must match
# the /etc/passwd entry baked into the image:
#     docker compose up -d --build
# VOXDOCK_UID=1000
# VOXDOCK_GID=1000

# ── Security & abuse limits (TODO P0) ───────────────────────────────────────
# VoxDock clones any voice it is sent, so these are the controls between "my
# laptop" and "an impersonation tool". With nothing configured the service is
# OPEN, which is fine on 127.0.0.1 and refused on any other address - the
# startup guard turns TTS_BIND_HOST=0.0.0.0 into a refusal unless you say
# otherwise here. See README section 6.
#
# API keys. One entry per ';', as <label>:<secret>:<scope>[|<scope>...]:
#   scopes: tts (synthesis) | speakers (register/list/delete) | admin
#           (clear-cache, detailed diagnostics) | * (everything)
# The secret must be at least 16 characters - a short one is refused at startup
# rather than quietly accepted. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(24))"
# TTS_API_KEYS=
# TTS_API_KEYS="pipeline:<secret>:tts;library:<secret>:speakers;ops:<secret>:admin"
#
# Publish on the network anyway, with no keys. This accepts the risk explicitly:
# anything that can reach the address can synthesise from any uploaded voice.
TTS_ALLOW_REMOTE=false
# Per key (or per peer address when open). 0 disables the limiter.
TTS_RATE_LIMIT_RPM=30
TTS_RATE_LIMIT_WINDOW_S=60.0
# Requests allowed to hold or wait for the GPU. 0 = no queue: everything beyond
# the one in flight is refused with 503 and a Retry-After. The refused
# Retry-After is the measured generation time, not a constant.
TTS_MAX_QUEUE_SIZE=4
# Caps that keep one caller from filling the disk or overrunning the 20.5 s
# patch budget. 0 disables. See app/config.py for how each default was derived.
TTS_MAX_SPEAKERS=50
TTS_MAX_TEXT_CHARS=2000
TTS_MAX_REFERENCE_SECONDS=20.0
TTS_MAX_AUDIO_SECONDS=20.0
# Accept `Authorization: Bearer <secret>` as well as `X-API-Key`. Set false if a
# reverse proxy in front already terminates auth and the service should honour
# the dedicated header only. Defence in depth, not a boundary: both headers
# carry the same secret.
TTS_ALLOW_BEARER=true
