# Local configuration. `.env` holds this machine's settings (and a slot for
# HF_TOKEN); `.env.example` is the committed template. `autotune.py --apply`
# writes timestamped backups named `<name>.env.bak-<stamp>`, hence both patterns.
.env
.env.bak-*
*.env.bak-*

# Voice recordings and derived audio: large, and personal. The transcripts
# (data/**/*.txt) and reference_set.json are kept - they are small and are what
# makes the cloning reproducible.
data/**/*.wav
data/temp_chunks/

# Registered speaker prompts: the WAVs are covered by the *.wav rule above, but
# the sidecar transcripts are personal too, so the whole store is ignored.
data/speakers/
# Downloaded model weights for scripts/speaker_similarity.py (ECAPA-TDNN, ~22 MB).
# Machine-local and regenerable, like the HF checkpoint cache in the container.
data/.speechbrain/

# Generated audio is ignored, but the JSON reports are kept: they are small and
# they are the evidence behind every number claimed in the docs
# (benchmark_report.json, tuning_report.json, best_config.json).
data/output/*.wav
data/output/*.raw.wav
data/output/*_raw.wav
# Per-candidate benchmark dumps written by autotune.py for crash-resume. The
# consolidated result lives in data/output/tuning_report.json, which is tracked;
# these 30+ intermediates are regenerable and only clutter the tree.
data/output/tune_*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

