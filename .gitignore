# Local configuration. `.env` holds this machine's settings (and a slot for
# HF_TOKEN); `.env.example` is the committed template. `autotune.py --apply`
# writes timestamped backups as `<name>.env.bak-<stamp>` - for `.env` itself the
# doubled extension (`.env.env.bak-...`, because `Path(".env").suffix` is empty)
# is expected, hence the single glob below.
.env
*.env.bak-*

# Voice recordings and derived audio: large, and personal. The transcripts
# (data/**/*.txt) and reference_set.json are kept - they are small and are what
# makes the cloning reproducible.
data/**/*.wav
data/temp_chunks/
# Control clips for speaker_similarity.py: two different VoxCeleb speakers,
# downloaded from the speechbrain model repo and used as the impostor floor.
# Public benchmark audio, not personal, but also not ours to track.
data/references/controls/

# Registered speaker prompts: the WAVs are covered by the *.wav rule above, but
# the sidecar transcripts are personal too, so the whole store is ignored.
data/speakers/
# Downloaded model weights for scripts/speaker_similarity.py (ECAPA-TDNN, ~22 M
# parameters / ~85 MB on disk). Machine-local and regenerable, like the HF
# checkpoint cache in the container.
data/.speechbrain/

# Generated audio is ignored, but the JSON reports are kept: they are small and
# they are the evidence behind every number claimed in the docs
# (benchmark_report.json, tuning_report.json, best_config.json).
data/output/*.wav
# Per-candidate benchmark dumps written by autotune.py for crash-resume. The
# consolidated result lives in data/output/tuning_report.json, which is tracked;
# these 30+ intermediates are regenerable and only clutter the tree.
data/output/tune_*.json
# Run artefacts that are not evidence. autotune.py writes tuned.env on every run
# (dry runs included) and process_txt.py writes <input>.report.json, so a run on
# a new input would otherwise appear in `git status`. Ignore rules never apply to
# files git already tracks, so the curated reports stay visible - re-add one that
# was deleted with `git add -f`.
data/output/tuned.env
data/output/*.report.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/


# Long soak-test input (1,400 words of filler), regenerable with a one-liner.
data/input/soak.txt
